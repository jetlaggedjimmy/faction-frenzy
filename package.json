{
  "name": "faction-frenzy",
  "version": "2.0.0",
  "description": "Faction Frenzy — a local desktop app that sorts Twitch viewers into factions, tracks points and renders OBS overlays.",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build:main": "tsc -p tsconfig.main.json",
    "build:web": "vite build",
    "build": "npm run build:main && npm run build:web",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "generate-presets": "node tools/generate-presets.mjs",
    "package": "npm run build && electron-builder --win"
  },
  "author": "jetlaggedjimmy",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "gg.factionfrenzy.app",
    "productName": "Faction Frenzy",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
