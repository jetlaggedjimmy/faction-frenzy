{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",           // ✨ modern, supported, stable
    "codebase": "default",
    "buildConfig": {
      "platform": "gcfv2"            // 👈 Explicitly enables 2nd gen
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/auth/**",
        "function": "api"
      },
      {
        "source": "/api/**",
        "function": "api"
      }
    ]
  }
}